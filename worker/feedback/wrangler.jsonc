{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pyro-nav-feedback-api",
  "main": "src/index.js",
  "account_id": "3d152e29b7960a444741e9aabec06b51",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://volderaxe.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pyro-nav-feedback",
      "database_id": "45d9d70c-8b78-4237-9c77-2e20a2da8bc8",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "FEEDBACK_LIMITER",
      "namespace_id": "981273645",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
